diff --git a/willuslib/wfile.c b/willuslib/wfile.c
index 5312058..ece8340 100644
--- a/willuslib/wfile.c
+++ b/willuslib/wfile.c
@@ -46,0 +47,4 @@
+#ifdef __IPHONE_OS_VERSION_MIN_REQUIRED
+#include <sys/statvfs.h>
+#include <utime.h>
+#endif
@@ -728,0 +733,13 @@ void wfile_set_mod_date(char *filename,struct tm *date)
+#elif defined(__IPHONE_OS_VERSION_MIN_REQUIRED)
+    struct stat st;
+    struct utimbuf times;
+    time_t modtime;
+
+    if (filename==NULL || date==NULL)
+        return;
+    modtime=mktime(date);
+    if (modtime==(time_t)-1)
+        return;
+    times.actime = stat(filename,&st)==0 ? st.st_atime : time(NULL);
+    times.modtime = modtime;
+    utime(filename,&times);
@@ -1085,0 +1103,16 @@ double wfile_freespace(char *volume,double *totalspace)
+#elif defined(__IPHONE_OS_VERSION_MIN_REQUIRED)
+    {
+    struct statvfs fs;
+    double blocksize;
+
+    if (statvfs(volume,&fs)!=0)
+        {
+        if (totalspace!=NULL)
+            (*totalspace) = -1;
+        return(-1);
+        }
+    blocksize = fs.f_frsize > 0 ? fs.f_frsize : fs.f_bsize;
+    if (totalspace!=NULL)
+        (*totalspace) = (double)fs.f_blocks * blocksize;
+    return((double)fs.f_bavail * blocksize);
+    }
@@ -1287,0 +1321,3 @@ int wfile_check_file_64bit(char *filename)
+#elif defined(__IPHONE_OS_VERSION_MIN_REQUIRED)
+    (void)filename;
+    return(0);
